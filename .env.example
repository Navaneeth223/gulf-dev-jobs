# MongoDB Atlas (M0). Database name can be gulf-dev-jobs.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/gulf-dev-jobs?retryWrites=true&w=majority

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional. Leave blank to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
